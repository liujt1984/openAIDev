<view class="page">
  <view wx:if="{{demo}}" class="demo">本地演示 · 所有家长、车辆和行程均为示例</view>
  <view class="hero">
    <view class="eyebrow" style="color:#fff">GX民高拼车</view>
    <view class="hero-title">🚗 找顺路家长</view>
    <view class="hero-note">武鸣民族高中往返接送</view>
    <view class="hero-bottom"><text>学校固定 · 路线自选</text><text bindtap="publish">发一程 ＋</text></view>
  </view>
  <view class="tabs"><view class="tab {{direction === 'home' ? 'active' : ''}}" data-value="home" bindtap="setDirection">放假回家 →</view><view class="tab {{direction === 'school' ? 'active' : ''}}" data-value="school" bindtap="setDirection">返校上学 →</view></view>
  <input class="field" placeholder="搜索城市、城区或途经区域" value="{{city}}" bindinput="setCity" />
  <view class="filters" style="margin-top:18rpx"><picker mode="date" value="{{date}}" bindchange="setDate"><view class="filter">{{date || '所有日期'}} ▾</view></picker><picker range="{{feeNames}}" value="{{feeIndex}}" bindchange="setFee"><view class="filter">{{feeNames[feeIndex]}} ▾</view></picker><picker range="{{childGenders}}" value="{{childGenderIndex}}" bindchange="setGender"><view class="filter">{{childGenders[childGenderIndex]}} ▾</view></picker><view class="filter" bindtap="resetFilters">重置</view></view>
  <view class="row between section"><view class="row"><text class="{{view === 'trips' ? 'link' : 'muted'}}" data-value="trips" bindtap="setView">有车同行</text><text class="{{view === 'needs' ? 'link' : 'muted'}}" data-value="needs" bindtap="setView">正在找车</text></view><text class="muted small">{{view === 'trips' ? filteredTrips.length : filteredNeeds.length}} 条</text></view>
  <view wx:if="{{error}}" class="error" bindtap="load">{{error}} · 点此重试</view>
  <view wx:if="{{loading}}" class="empty">正在寻找同路人…</view>
  <block wx:elif="{{view === 'trips'}}">
    <view wx:for="{{filteredTrips}}" wx:key="id" class="card" bindtap="open" data-id="{{item.id}}">
      <view class="row between"><text class="pill">{{item.date}} · {{item.time}}</text><view class="row"><text wx:if="{{item.riderGender !== 'any'}}" class="pill amber">{{item.riderGenderLabel}}</text><text class="small muted">余 {{item.remaining}} 座</text></view></view>
      <view class="route">{{item.from}} → {{item.to}}</view><view class="muted">{{item.via || '上下车位置由双方确认'}}</view>
      <view class="divider"/><view class="row between"><text>{{item.ownerName}}</text><text class="price">{{item.feeLabel}}</text></view>
    </view>
    <view wx:if="{{!filteredTrips.length}}" class="empty"><view class="empty-title">还没有合适的同行</view><view>试试调整条件，或发布搭车需求</view><button class="btn secondary" bindtap="publish">发布我的需求</button></view>
  </block>
  <block wx:else>
    <view wx:for="{{filteredNeeds}}" wx:key="id" class="card"><view class="row between"><text class="pill amber">寻找顺路家长</text><text class="muted small">{{item.date}} {{item.time}}</text></view><view class="route">{{item.direction === 'home' ? '学校 → ' : ''}}{{item.city}}{{item.direction === 'school' ? ' → 学校' : ''}}</view><view class="row between"><text>{{item.ownerName}} · 1 位学生{{item.studentGenderLabel ? '（' + item.studentGenderLabel + '）' : ''}}</text><button class="btn mini secondary" data-id="{{item.id}}" bindtap="invite">邀请同行</button></view></view>
    <view wx:if="{{!filteredNeeds.length}}" class="empty">暂无符合条件的搭车需求</view>
  </block>
</view>

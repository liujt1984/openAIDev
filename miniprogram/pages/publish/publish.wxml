<view class="page"><view class="eyebrow">GX民高拼车</view><view class="title">发一程</view>
  <view class="tabs"><view class="tab {{kind === 'drive' ? 'active' : ''}}" data-value="drive" bindtap="kind">🚗 我开车</view><view class="tab {{kind === 'need' ? 'active' : ''}}" data-value="need" bindtap="kind">🧒 我搭车</view></view>
  <view wx:if="{{!profile.routeTemplates.length}}" class="card"><view class="section" style="margin-top:0">先建立线路模板</view><view class="muted">模板保存固定的学校方向、家庭端区域和上下车地点；以后发布只需选模板并填写日期。</view><button class="btn secondary" bindtap="goTemplates">去创建线路模板</button></view>
  <block wx:else><view class="card"><view class="section" style="margin-top:0">1. 选择线路</view><picker range="{{templateOptions}}" range-key="name" value="{{templateIndex}}" bindchange="template"><view class="field">{{templateOptions[templateIndex].name}} ▾</view></picker>
    <block wx:if="{{selected}}"><view class="template"><view class="template-title">{{selected.direction === 'home' ? '🏫 学校 → ' : '🏠 家 → '}}{{selected.city}}</view><view class="muted small template-line">📍 集合：{{selected.meet}}</view><view class="muted small template-line">🏁 下车：{{selected.drop}}</view></view></block>
  </view>
  <block wx:if="{{selected}}"><view class="card"><view class="section" style="margin-top:0">2. 本次安排</view><view class="row"><view class="half"><view class="label">日期</view><picker mode="date" value="{{form.date}}" data-key="date" bindchange="input"><view class="field">{{form.date}}</view></picker></view><view class="half"><view class="label">出发时间</view><picker mode="time" value="{{form.time}}" data-key="time" bindchange="input"><view class="field">{{form.time}}</view></picker></view></view>
    <block wx:if="{{kind === 'drive'}}"><view class="row"><view class="half"><view class="label">空余座位</view><input class="field" type="number" value="{{form.seats}}" data-key="seats" bindinput="input"/></view><view class="half"><view class="label">自家人数</view><input class="field" type="number" value="{{form.ownCount}}" data-key="ownCount" bindinput="input"/></view></view><view class="label">本次车辆</view><picker range="{{profile.vehicles}}" range-key="name" value="{{vehicleIndex}}" bindchange="vehicle"><view class="field">{{profile.vehicles[vehicleIndex].name || '请先添加车辆'}} ▾</view></picker><view class="label">搭乘学生性别要求</view><view class="tabs"><view class="tab {{form.riderGender === 'any' ? 'active' : ''}}" data-value="any" bindtap="riderGender">不限</view><view class="tab {{form.riderGender === 'girl' ? 'active' : ''}}" data-value="girl" bindtap="riderGender">仅女生</view><view class="tab {{form.riderGender === 'boy' ? 'active' : ''}}" data-value="boy" bindtap="riderGender">仅男生</view></view><view class="muted small">限定性别后，性别不符或未填写性别的申请将被自动拒绝，名单与列表会显示该要求。</view></block>
    <block wx:else><view class="label">搭车学生</view><picker range="{{profile.students}}" range-key="name" value="{{studentIndex}}" bindchange="student"><view class="field">{{profile.students[studentIndex].name || '请先添加孩子'}} ▾</view></picker><view wx:if="{{profile.students[studentIndex].gender}}" class="muted small">孩子性别：{{profile.students[studentIndex].gender === 'girl' ? '女生' : '男生'}}，将随需求展示给车主。</view></block>
  </view>
  <view class="card"><view class="section" style="margin-top:0">3. 费用</view><picker range="{{fees}}" value="{{feeIndex}}" bindchange="fee"><view class="field">{{fees[feeIndex]}} ▾</view></picker><block wx:if="{{kind === 'drive' && form.feeMode === 'fixed'}}"><view class="label">每位学生金额（元）</view><input class="field" type="digit" value="{{form.fixedYuan}}" data-key="fixedYuan" bindinput="input"/></block><block wx:if="{{kind === 'drive' && form.feeMode === 'aa'}}"><view class="row"><view class="half"><view class="label">每公里成本</view><input class="field" type="digit" value="{{form.rateYuan}}" data-key="rateYuan" bindinput="input"/></view><view class="half"><view class="label">预估公里</view><input class="field" type="digit" value="{{form.estimatedKm}}" data-key="estimatedKm" bindinput="input"/></view></view><view class="label">预估过路费（元）</view><input class="field" type="digit" value="{{form.tollYuan}}" data-key="tollYuan" bindinput="input"/></block><view wx:if="{{kind === 'drive'}}" class="label">说明（选填）</view><textarea wx:if="{{kind === 'drive'}}" class="field" value="{{form.note}}" data-key="note" bindinput="input" placeholder="行李、等待时间等"/></view>
  <button class="btn" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">{{kind === 'drive' ? '发布开车行程' : '发布找车需求'}}</button></block></block>
</view>

<view class="page">
  <view wx:if="{{error}}" class="error" bindtap="load">{{error}} · 点此重试</view><view wx:if="{{loading}}" class="empty">正在加载行程…</view>
  <block wx:elif="{{trip}}">
    <view wx:if="{{demo}}" class="demo">本地演示数据</view>
    <view class="hero"><view class="row between"><text class="pill">{{trip.direction === 'home' ? '放假回家' : '返校上学'}}</text><text>{{trip.status === 'cancelled' ? '已取消' : trip.status === 'completed' ? '已完成' : '余 ' + trip.remaining + ' 座'}}</text></view><view class="hero-title">{{trip.from}}<view style="font-size:28rpx;margin:8rpx 0">↓</view>{{trip.to}}</view><view class="hero-bottom"><text>{{trip.date}} · {{trip.time}}</text><text>{{trip.ownerName}}</text></view></view>
    <view wx:if="{{trip.riderGender !== 'any'}}" class="notice">🚻 本行程搭乘学生要求：{{trip.riderGenderLabel}}，性别不符的孩子无法提交申请。</view>
    <view class="card"><view class="row between"><text class="section" style="margin:0">💰 费用</text><text class="price">{{trip.feeLabel}}</text></view><view style="margin-top:14rpx">{{feeRule}}</view><view wx:if="{{estimate}}" class="notice">{{estimate}}<view class="small">实际金额以完成接送后账单为准。</view></view></view>
    <view wx:if="{{trip.meet}}" class="card"><view class="section" style="margin-top:0">接送确认单</view><view class="step"><view class="step-title">集合点</view><view>{{trip.meet}}</view></view><view class="step"><view class="step-title">下车点</view><view>{{trip.drop}}</view></view><view class="row between"><text>{{trip.car}}</text><text class="pill">{{trip.plate}}</text></view><view class="contact" data-phone="{{trip.phone}}" bindtap="call">开车家长：{{trip.phone}}　☎</view><view wx:if="{{trip.backup}}" class="contact" data-phone="{{trip.backup}}" bindtap="call">备用联系：{{trip.backup}}　☎</view><view class="muted">{{trip.note}}</view></view>
    <view wx:else class="notice">确认搭乘后展示详细集合点、车辆和电话。确认前请先核对区域、时间和费用。</view>
    <view wx:if="{{!trip.isOwner && trip.status === 'open' && trip.remaining > 0 && !students.length && trip.riderGender !== 'any'}}" class="notice">本行程{{trip.riderGender === 'girl' ? '仅接受女生' : '仅接受男生'}}搭乘，当前没有符合条件的孩子；请先在“我的”孩子档案中补充性别。</view>
    <view wx:if="{{!trip.isOwner && trip.status === 'open' && trip.remaining > 0 && students.length}}" class="card"><view class="section" style="margin-top:0">为孩子申请搭乘</view><picker range="{{students}}" range-key="name" value="{{studentIndex}}" bindchange="student"><view class="field">{{students[studentIndex].name}} ▾</view></picker><view class="label">孩子上下车路线</view><picker wx:if="{{routeTemplates.length}}" range="{{routeTemplates}}" range-key="name" value="{{routeTemplateIndex}}" bindchange="routeTemplate"><view class="field">{{routeTemplates[routeTemplateIndex].name}} ▾</view></picker><view wx:else class="notice">请先到“我的”保存与本次同方向的路线模板。</view><button class="btn" disabled="{{busy || !routeTemplates.length}}" bindtap="apply">申请搭乘 · 等待车主确认</button></view>
    <view class="row between section"><text>{{trip.isOwner ? '搭乘名单' : '我的搭乘记录'}}</text><text wx:if="{{trip.isOwner}}" class="link small" bindtap="copyRoster">复制点名名单</text></view>
    <view wx:if="{{!trip.applications.length}}" class="card muted">{{trip.isOwner ? '尚未收到搭乘申请。' : '暂无申请；请先在“我的”添加孩子。'}}</view>
    <view wx:for="{{trip.applications}}" wx:key="id" wx:for-item="a" class="card">
      <view class="row between"><view><text style="font-weight:650">{{a.studentName}}{{a.studentGenderLabel ? '（' + a.studentGenderLabel + '）' : ''}}</text><view class="muted small">{{a.parentName}}</view></view><text class="pill {{a.status === 'exception' ? 'amber' : ''}}">{{a.statusLabel}}</text></view>
      <block wx:if="{{a.canContact}}"><view class="divider"/><view class="row between"><text>接头编号：{{a.code}}</text><text class="link small" data-id="{{a.id}}" bindtap="copyCard">复制确认单</text></view><view wx:if="{{a.meet}}" class="muted small">学生上车点：{{a.meet}}</view><view wx:if="{{a.drop}}" class="muted small">学生下车点：{{a.drop}}</view><view class="notice" wx:if="{{!a.informed}}">请先确认学生已知晓接送安排。</view><view wx:else class="muted small" style="margin-top:14rpx">已告知：{{a.informMethod}}</view><view wx:if="{{trip.isOwner}}" class="contact" data-phone="{{a.phone}}" bindtap="call">家长：{{a.phone}}　☎</view><view wx:if="{{trip.isOwner && a.backup}}" class="contact" data-phone="{{a.backup}}" bindtap="call">备用：{{a.backup}}　☎</view></block>
      <button wx:if="{{(trip.isOwner && a.status === 'pending') || (!trip.isOwner && a.status === 'invited')}}" class="btn" disabled="{{busy}}" data-id="{{a.id}}" bindtap="accept">{{a.status === 'invited' ? '接受邀请并确认费用' : '接受申请 · 确认座位'}}</button>
      <button wx:if="{{!trip.isOwner && a.status === 'confirmed' && !a.informed}}" class="btn" disabled="{{busy}}" data-id="{{a.id}}" bindtap="inform">确认已告知学生</button>
      <button wx:if="{{trip.isOwner && a.status === 'confirmed'}}" class="btn" disabled="{{busy || !a.informed}}" data-id="{{a.id}}" data-status="boarded" bindtap="progress">核对身份 · 已上车</button>
      <button wx:if="{{trip.isOwner && a.status === 'boarded'}}" class="btn" disabled="{{busy}}" data-id="{{a.id}}" data-status="arrived" bindtap="progress">确认已到达下车点</button>
      <button wx:if="{{trip.isOwner && a.status === 'arrived'}}" class="btn" disabled="{{busy}}" data-id="{{a.id}}" data-status="handed" bindtap="progress">记录交接 / 返校下车</button>
      <button wx:if="{{trip.isOwner && a.status === 'exception'}}" class="btn secondary" disabled="{{busy}}" data-id="{{a.id}}" bindtap="resolve">记录异常处理结果</button>
      <view class="actions"><button wx:if="{{a.canCancel}}" class="btn mini secondary" disabled="{{busy}}" data-id="{{a.id}}" bindtap="cancelApplication">{{trip.isOwner && a.status === 'pending' ? '拒绝申请' : '取消搭乘'}}</button><button wx:if="{{a.canException}}" class="btn mini danger" disabled="{{busy}}" data-id="{{a.id}}" bindtap="exception">登记异常</button></view>
      <view wx:if="{{a.events.length}}" class="divider"/><view wx:for="{{a.events}}" wx:key="index" wx:for-item="event" class="small muted" style="margin-top:8rpx">{{event.when}}　{{event.text}}</view>
    </view>
    <view wx:if="{{canBill}}" class="card"><view class="section" style="margin-top:0">完成接送 · 生成账单</view><block wx:if="{{trip.feeMode === 'aa'}}"><view class="label">实际共同路段公里</view><input class="field" type="digit" value="{{actualKm}}" data-key="actualKm" bindinput="input"/><view class="label">实际过路费（元）</view><input class="field" type="digit" value="{{tollYuan}}" data-key="tollYuan" bindinput="input"/></block><button class="btn" disabled="{{busy}}" bindtap="bill">{{trip.feeMode === 'free' ? '完成免费行程' : '生成账单，等待家长确认'}}</button></view>
    <view wx:if="{{trip.bill}}" class="card"><view class="section" style="margin-top:0">本次账单</view><view wx:if="{{trip.feeMode === 'aa'}}" class="muted small">实际 {{trip.bill.actualKm}} 公里 · {{trip.bill.totalPeople}} 人分摊<view>实际过路费 ¥{{trip.bill.tollYuan}} · 共同费用 ¥{{trip.bill.totalYuan}}</view><view>开车家庭承担 ¥{{trip.bill.ownShareYuan}}（含尾差）</view></view><view wx:for="{{trip.bill.shares}}" wx:key="applicationId" wx:for-item="s"><view class="divider"/><view class="row between"><text>{{s.studentName}}</text><text class="money">¥{{s.yuan}}</text></view><view class="muted small">{{s.settled ? '双方已记录线下结清（非平台核验）' : s.confirmed ? '金额已确认，待双方记录线下结清' : '等待搭乘家长确认金额'}}</view><button wx:if="{{!trip.isOwner && !s.confirmed}}" class="btn secondary" disabled="{{busy}}" data-id="{{s.applicationId}}" bindtap="confirmBill">确认账单金额</button><button wx:if="{{s.confirmed && !s.settled && ((trip.isOwner && !s.driverPaid) || (!trip.isOwner && !s.parentPaid))}}" class="btn secondary" disabled="{{busy}}" data-id="{{s.applicationId}}" bindtap="paid">{{trip.isOwner ? '记录已线下收款' : '记录已线下付款'}}</button></view></view>
    <view wx:if="{{!trip.isOwner}}" class="actions"><button class="btn secondary mini" bindtap="favorite">{{favorited ? '取消收藏' : '收藏同路家长'}}</button><button class="btn secondary mini" bindtap="block">屏蔽 / 解除</button><button class="btn secondary mini" bindtap="report">举报</button></view>
    <button wx:if="{{trip.isOwner && trip.status === 'open'}}" class="btn danger" disabled="{{busy}}" bindtap="cancelTrip">取消整个行程</button>
    <view class="footer-note">请停车后记录接送状态</view>
  </block>
</view>

<view class="page"><view class="eyebrow">GX民高拼车</view><view class="title">我的</view>
  <view wx:if="{{demo}}" class="demo"><picker range="{{userNames}}" value="{{userIndex}}" bindchange="switchUser"><view>{{userNames[userIndex]}} ▾</view></picker></view>
  <view class="card"><view class="section" style="margin-top:0">家长档案</view><view class="label">称呼</view><input class="field" value="{{profile.name}}" data-key="name" bindinput="input" placeholder="如：小林家长"/><view class="label">联系电话</view><input class="field" type="number" value="{{profile.phone}}" data-key="phone" bindinput="input" maxlength="11"/><view class="label">备用电话</view><input class="field" type="number" value="{{profile.backup}}" data-key="backup" bindinput="input" maxlength="11"/></view>
  <view class="card"><view class="row between"><text class="section" style="margin:0">孩子档案</text><text class="link" bindtap="addStudent">＋ 添加</text></view><view class="muted small">性别用于拼车搭乘要求匹配（车主可限定仅男生 / 仅女生）。</view><view wx:for="{{profile.students}}" wx:key="index" class="template"><view class="row"><input class="field half" value="{{item.name}}" placeholder="学生姓名" data-index="{{index}}" data-key="name" bindinput="studentInput"/><input class="field half" value="{{item.grade}}" placeholder="年级" data-index="{{index}}" data-key="grade" bindinput="studentInput"/></view><view class="row between" style="margin-top:12rpx"><picker class="half" range="{{studentGenders}}" value="{{item.gender === 'girl' ? 2 : item.gender === 'boy' ? 1 : 0}}" data-index="{{index}}" bindchange="studentGender"><view class="field">{{studentGenders[item.gender === 'girl' ? 2 : item.gender === 'boy' ? 1 : 0]}} ▾</view></picker><text class="link small" data-index="{{index}}" bindtap="removeStudent">删除此孩子</text></view></view></view>
  <view class="card"><view class="row between"><text class="section" style="margin:0">车辆档案</text><text class="link" bindtap="addVehicle">＋ 添加</text></view><view class="muted small">有车时可发布开车行程；没有车也可保存路线并发布找车需求。</view><view wx:for="{{profile.vehicles}}" wx:key="index" class="template"><view class="label">车辆名称</view><input class="field" value="{{item.name}}" placeholder="如：白色 SUV" data-index="{{index}}" data-key="name" bindinput="vehicleInput"/><view class="row"><input class="field half" value="{{item.car}}" placeholder="颜色与型号" data-index="{{index}}" data-key="car" bindinput="vehicleInput"/><input class="field half" value="{{item.plate}}" placeholder="车牌" data-index="{{index}}" data-key="plate" bindinput="vehicleInput"/></view><text class="link small" data-index="{{index}}" bindtap="removeVehicle">删除此车辆</text></view></view>
  <button class="btn" bindtap="save" loading="{{busy}}" disabled="{{busy || loading}}">保存家庭档案</button>
  <view class="card"><view class="row between"><text class="section" style="margin:0">⭐ 常用线路模板</text><text class="link" bindtap="startTemplate">＋ 新建</text></view><view class="muted small" style="margin-top:12rpx">先保存固定路线，发布时只选路线、日期和本次安排。一个模板同时可用于开车或搭车。</view><view wx:for="{{profile.routeTemplates}}" wx:key="id" class="template"><view class="row between"><view class="grow"><view class="template-title">{{item.name}}</view><view class="muted small">{{item.direction === 'home' ? '🏫 学校 → ' : '🏠 家 → '}}{{item.city}}</view></view><view class="template-actions"><text class="link small" data-id="{{item.id}}" bindtap="editTemplate">编辑</text><text class="link small" data-id="{{item.id}}" bindtap="deleteTemplate">删除</text></view></view><view class="muted small template-line">📍 集合：{{item.meet || '待补充'}}</view><view class="muted small template-line">🏁 下车：{{item.drop || '待补充'}}</view></view><view wx:if="{{!profile.routeTemplates.length}}" class="muted" style="margin-top:18rpx">还没有模板。新建一条“学校 ↔ 家”的常走线路后，即可发布行程。</view></view>
  <view wx:if="{{editingTemplate}}" class="card"><view class="row between"><text class="section" style="margin:0">{{templateDraft.id ? '编辑' : '新建'}}线路模板</text><text class="link" bindtap="cancelTemplate">取消</text></view><view class="label">模板名称</view><input class="field" value="{{templateDraft.name}}" data-key="name" bindinput="templateInput" placeholder="如：南宁安吉周末往返"/><view class="label">行程方向</view><view class="tabs"><view class="tab {{templateDraft.direction === 'home' ? 'active' : ''}}" data-value="home" bindtap="templateDirection">🏫 学校 → 家</view><view class="tab {{templateDraft.direction === 'school' ? 'active' : ''}}" data-value="school" bindtap="templateDirection">🏠 家 → 学校</view></view><view class="label">家庭端区域</view><input class="field" value="{{templateDraft.city}}" data-key="city" bindinput="templateInput" placeholder="如：南宁 · 安吉"/><view class="label">固定集合点</view><view class="address" data-key="meet" bindtap="chooseTemplateLocation"><text class="address-name">{{templateDraft.meet || '📍 在地图中选择'}}</text><text class="link small">选择</text></view><view class="label">固定下车点</view><view class="address" data-key="drop" bindtap="chooseTemplateLocation"><text class="address-name">{{templateDraft.drop || '📍 在地图中选择'}}</text><text class="link small">选择</text></view><view class="label">常走途经地（选填）</view><input class="field" value="{{templateDraft.via}}" data-key="via" bindinput="templateInput" placeholder="如：安吉大道"/>
    <view class="row"><view class="half"><view class="label">默认空余座位</view><input class="field" type="number" value="{{templateDraft.seats}}" data-key="seats" bindinput="templateInput"/></view><view class="half"><view class="label">默认自家人数</view><input class="field" type="number" value="{{templateDraft.ownCount}}" data-key="ownCount" bindinput="templateInput"/></view></view><view wx:if="{{profile.vehicles.length}}"><view class="label">默认车辆（开车时可改）</view><picker range="{{profile.vehicles}}" range-key="name" value="{{templateVehicleIndex}}" bindchange="templateVehicle"><view class="field">{{profile.vehicles[templateVehicleIndex].name}} ▾</view></picker></view><view class="label">默认费用方式</view><picker range="{{['免费互助','固定费用','按公里 AA']}}" value="{{templateFeeIndex}}" bindchange="templateFee"><view class="field">{{['免费互助','固定费用','按公里 AA'][templateFeeIndex]}} ▾</view></picker><block wx:if="{{templateDraft.feeMode === 'fixed'}}"><view class="label">每位学生金额（元）</view><input class="field" type="digit" value="{{templateDraft.fixedYuan}}" data-key="fixedYuan" bindinput="templateInput"/></block><block wx:if="{{templateDraft.feeMode === 'aa'}}"><view class="row"><view class="half"><view class="label">每公里成本（元）</view><input class="field" type="digit" value="{{templateDraft.rateYuan}}" data-key="rateYuan" bindinput="templateInput"/></view><view class="half"><view class="label">预估公里</view><input class="field" type="digit" value="{{templateDraft.estimatedKm}}" data-key="estimatedKm" bindinput="templateInput"/></view></view><view class="label">预估过路费（元）</view><input class="field" type="digit" value="{{templateDraft.tollYuan}}" data-key="tollYuan" bindinput="templateInput"/></block><button class="btn" loading="{{busy}}" disabled="{{busy}}" bindtap="saveTemplate">保存线路模板</button></view>
  <view wx:if="{{profile.favorites.length}}" class="card"><view class="section" style="margin-top:0">收藏的家长</view><view wx:for="{{profile.favorites}}" wx:key="*this" class="row between"><text>同路家长 {{index + 1}}</text><text class="link small" data-id="{{item}}" bindtap="unfavorite">取消收藏</text></view></view><view wx:if="{{profile.blocked.length}}" class="card"><view class="section" style="margin-top:0">已屏蔽</view><view wx:for="{{profile.blocked}}" wx:key="*this" class="row between"><text>家长 {{index + 1}}</text><text class="link small" data-id="{{item}}" bindtap="unblock">解除</text></view></view><button wx:if="{{demo}}" class="btn secondary" bindtap="reset">恢复演示数据</button>
</view>

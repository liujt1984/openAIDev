<view class="page"><view class="eyebrow">GX民高拼车</view><view class="title">我的行程</view>
  <view class="quick-grid"><view class="quick" bindtap="publish">➕ 发布接送</view><view class="quick purple" bindtap="tab" data-value="history">🕘 历史记录</view></view>
  <view wx:if="{{profile.routeTemplates.length}}" class="card"><view class="row between"><text class="section" style="margin:0">⭐ 我的常用路线</text><text class="link" bindtap="publish">用模板发布</text></view><view wx:for="{{profile.routeTemplates}}" wx:key="id" class="template"><text class="template-title">{{item.name}}</text><text class="muted small">{{item.direction === 'home' ? '🏫 学校 → ' : '🏠 家 → '}}{{item.city}}</text></view></view>
  <view class="tabs"><view class="tab {{view === 'active' ? 'active' : ''}}" data-value="active" bindtap="tab">待安排 {{activeCount}}</view><view class="tab {{view === 'drive' ? 'active' : ''}}" data-value="drive" bindtap="tab">我开车</view><view class="tab {{view === 'ride' ? 'active' : ''}}" data-value="ride" bindtap="tab">我搭车</view></view>
  <view wx:if="{{error}}" class="error" bindtap="load">{{error}} · 点此重试</view><view wx:if="{{loading}}" class="empty">加载中…</view>
  <block wx:elif="{{view !== 'history'}}"><view wx:for="{{filtered}}" wx:key="id" class="card" data-id="{{item.id}}" data-type="{{item.itemType}}" bindtap="open"><view class="row between"><text class="pill">{{item.date}} {{item.time}}</text><text class="muted small">{{item.feeLabel}}</text></view><view class="route">{{item.routeText}}</view><view class="row between"><text>{{item.caption}}</text><text wx:if="{{item.itemType === 'trip'}}" class="link">详情 →</text><text wx:else class="pill {{item.status === 'matched' ? 'amber' : ''}}">{{item.status === 'open' ? '寻找中' : item.status === 'matched' ? '已匹配' : '已关闭'}}</text></view><button wx:if="{{item.itemType === 'need' && item.status === 'open'}}" class="btn mini secondary" data-id="{{item.id}}" bindtap="closeNeed">关闭找车需求</button></view><view wx:if="{{!filtered.length}}" class="empty"><view class="empty-title">暂无待安排事项</view><view class="muted">先在“我的”保存路线模板，再发布开车行程或找车需求。</view><button class="btn secondary" bindtap="publish">去发布</button></view></block>
  <block wx:else><view wx:for="{{filtered}}" wx:key="id" class="card" data-id="{{item.id}}" data-type="{{item.itemType}}" bindtap="open"><view class="row between"><text class="pill gray">{{item.status === 'completed' ? '已完成' : item.status === 'closed' ? '已关闭' : '已取消'}}</text><text class="small muted">{{item.date}} {{item.time}}</text></view><view class="route">{{item.routeText}}</view><view class="muted">{{item.caption}}</view></view><view wx:if="{{!filtered.length}}" class="empty">暂无历史记录</view></block>
</view>

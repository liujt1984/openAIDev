page{background:#fff8f0;color:#31263d;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx;line-height:1.55}view,text,input,textarea,button{box-sizing:border-box}.page{padding:28rpx 28rpx 64rpx}.eyebrow{font-size:22rpx;letter-spacing:2rpx;color:#ee7350;font-weight:700}.title{font-size:46rpx;font-weight:800;letter-spacing:-1rpx;margin:6rpx 0}.subtitle,.muted{color:#827887;font-size:25rpx}.hero{padding:34rpx;background:linear-gradient(135deg,#ff7654,#ffb64b);color:white;border-radius:32rpx;margin-bottom:24rpx;box-shadow:0 12rpx 28rpx #f2693430}.hero-title{font-size:43rpx;font-weight:800;margin:12rpx 0}.hero-note{font-size:24rpx;opacity:.88}.hero-bottom{display:flex;justify-content:space-between;align-items:center;margin-top:26rpx;padding-top:18rpx;border-top:1rpx solid #ffffff66}.card{background:#fff;border:1rpx solid #f1e4da;border-radius:24rpx;padding:26rpx;margin-bottom:20rpx;box-shadow:0 5rpx 14rpx #5936150b}.row{display:flex;align-items:center;gap:16rpx}.between{justify-content:space-between}.wrap{flex-wrap:wrap}.grow{flex:1;min-width:0}.section{font-size:31rpx;font-weight:750;margin:26rpx 0 16rpx}.pill{display:inline-block;background:#fff0e8;color:#d95434;padding:6rpx 16rpx;border-radius:14rpx;font-size:22rpx;font-weight:650}.pill.amber{background:#fff2ce;color:#a96c00}.pill.gray{background:#f0eff4;color:#756e7e}.route{font-size:33rpx;font-weight:750;margin:18rpx 0 9rpx}.divider{height:1rpx;background:#f3ebe6;margin:20rpx 0}.price{font-size:30rpx;font-weight:800;color:#f05a36}.small{font-size:22rpx}.notice{padding:18rpx 20rpx;background:#fff4d9;color:#82612c;border-radius:16rpx;font-size:24rpx;margin:16rpx 0}.demo{font-size:22rpx;background:#eaf0ff;color:#536da7;padding:12rpx 20rpx;border-radius:12rpx;margin-bottom:20rpx}.tabs{display:flex;background:#f3e8e2;padding:7rpx;border-radius:18rpx;margin:20rpx 0;gap:6rpx}.tab{flex:1;text-align:center;padding:14rpx 6rpx;font-size:26rpx;border-radius:13rpx;color:#86747a}.tab.active{background:#fff;color:#ed5937;font-weight:750;box-shadow:0 3rpx 10rpx #8d54330d}.filters{display:flex;gap:12rpx;flex-wrap:wrap;margin-bottom:22rpx}.filter{padding:11rpx 18rpx;background:white;border:1rpx solid #f0ded6;border-radius:30rpx;font-size:24rpx}.label{font-size:25rpx;font-weight:700;margin:20rpx 0 10rpx}.field{background:#fffaf7;border:1rpx solid #efdeda;border-radius:13rpx;padding:19rpx;font-size:28rpx;min-height:84rpx;width:100%;color:#3a3040}input.field{height:88rpx}textarea.field{height:140rpx}.half{flex:1;min-width:0}.btn{background:#f05a36;color:white;border-radius:15rpx;font-size:28rpx;line-height:1.4;padding:22rpx 24rpx;font-weight:750;margin:16rpx 0;min-height:82rpx;box-shadow:0 6rpx 14rpx #ef5a3630}.btn::after{border:none}.btn.secondary{background:#fff0e9;color:#d75231;box-shadow:none}.btn.danger{background:#fff0ed;color:#b84138;box-shadow:none}.btn.mini{padding:12rpx 18rpx;min-height:58rpx;font-size:24rpx;margin:6rpx 0}.btn[disabled]{background:#e2d9d5;color:#988d8a;box-shadow:none}.actions{display:flex;gap:16rpx}.actions .btn{flex:1}.empty{text-align:center;padding:66rpx 20rpx;color:#877a84}.empty-title{color:#5c4050;font-size:30rpx;font-weight:700;margin:12rpx}.avatar{width:74rpx;height:74rpx;background:#fff0dc;color:#e66837;border-radius:24rpx;text-align:center;line-height:74rpx;font-weight:800;font-size:28rpx}.step{border-left:3rpx solid #ffb66d;padding:0 0 22rpx 22rpx;margin-left:10rpx}.step-title{font-size:27rpx;font-weight:700}.contact{font-size:27rpx;color:#e05132;padding:12rpx 0}.money{font-size:44rpx;font-weight:800}.footer-note{text-align:center;color:#9a8d94;font-size:22rpx;margin-top:30rpx}.link{color:#ec5938;font-weight:750}.check{display:flex;align-items:flex-start;margin:16rpx 0;font-size:25rpx;gap:8rpx}.break{word-break:break-all}.error{color:#a14d37;background:#ffede6;padding:20rpx;border-radius:14rpx;margin-bottom:20rpx}.icon{font-size:34rpx;margin-right:10rpx}.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.quick{padding:22rpx;border-radius:20rpx;background:#fff3ea;color:#ba4b31;font-weight:700}.quick.purple{background:#f2ecff;color:#714cc8}.template{padding:20rpx;border:1rpx solid #f0dfd6;border-radius:18rpx;margin-top:14rpx}.template-title{font-weight:750;font-size:28rpx}.template-actions{flex-shrink:0;white-space:nowrap;display:flex;gap:18rpx;align-items:center}.template-line{margin-top:8rpx;word-break:break-all}.address{display:flex;align-items:center;justify-content:space-between;background:#fffaf7;border:1rpx solid #efdeda;padding:19rpx;border-radius:13rpx;min-height:84rpx}.address-name{max-width:500rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.tag{font-size:22rpx;padding:5rpx 12rpx;border-radius:12rpx;background:#f4ecff;color:#7046c6}
